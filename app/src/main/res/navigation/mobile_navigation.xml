    <fragment
        android:id="@+id/nav_reports"
        android:name="com.whereismy.money.ui.reports.ReportFragment"
        android:label="@string/menu_reports"
        tools:layout="@layout/fragment_report" />

    <fragment
        android:id="@+id/nav_business"
        android:name="com.whereismy.money.ui.section.SectionFragment"
        android:label="@string/menu_business"
