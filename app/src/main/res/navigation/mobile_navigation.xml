<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.whereismy.money.ui.home.HomeFragment"
        android:label="@string/menu_dashboard"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_accounts"
        android:name="com.whereismy.money.ui.section.SectionFragment"
        android:label="@string/menu_accounts"
        tools:layout="@layout/fragment_section" />

    <fragment
        android:id="@+id/nav_transactions"
        android:name="com.whereismy.money.ui.transactions.TransactionFragment"
        android:label="@string/menu_transactions"
