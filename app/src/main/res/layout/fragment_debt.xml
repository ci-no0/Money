<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Debts &amp; Loans"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/debt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/debt_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/debt_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/debt_title"
            android:inputType="textCapSentences" />

        <Spinner
            android:id="@+id/debt_direction_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/debt_directions" />

        <EditText
            android:id="@+id/debt_principal_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debt_principal"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/debt_interest_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debt_interest"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/debt_fee_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debt_fee"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/debt_months_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debt_months"
            android:inputType="number" />

        <Button
            android:id="@+id/create_debt_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/create_debt" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/make_payment"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/payment_debt_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/payment_account_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/payment_amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/payment_amount"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/create_payment_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_payment" />

            <Button
                android:id="@+id/post_receipt_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/post_debt_receipt" />

    </LinearLayout>
</ScrollView>
